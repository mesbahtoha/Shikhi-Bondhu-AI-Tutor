# Base URL of the backend API.
# Local dev:  http://localhost:3000
# Vercel:     leave as-is. Production builds call /api on their own origin and
#             Vercel proxies /api/* to the backend configured in vercel.json.
#             This avoids a second TLS connection that mobile carriers often
#             fail to open, plus the CORS preflight.
# Override:   set VITE_API_SAME_ORIGIN=false to force VITE_API_BASE_URL in prod.
VITE_API_BASE_URL=http://localhost:3000
